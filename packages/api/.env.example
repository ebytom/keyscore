# =================================
# KeyScore - Production Environment
# =================================

# Server
NODE_ENV=production
PORT=4000

# MongoDB (Railway will provide this)
MONGODB_URI=mongodb://mongo:***@containers-us-west-xxx.railway.app:xxxx/keyscore

# JWT Secrets (generate strong secrets for production!)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Client URL (your Vercel deployment URL)
CLIENT_URL=https://keyscore.vercel.app

# OAuth (optional - configure if needed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-api.railway.app/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://your-api.railway.app/api/auth/github/callback

# OpenAI (optional - for AI features)
OPENAI_API_KEY=
