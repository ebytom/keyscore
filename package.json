{
  "name": "keyscore",
  "version": "1.0.0",
  "private": true,
  "description": "KeyScore - Free ATS Resume Checker",
  "author": "KeyScore Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:web": "pnpm --filter @keyscore/web dev",
    "dev:api": "pnpm --filter @keyscore/api dev",
    "build": "pnpm run build:shared && pnpm run build:web && pnpm run build:api",
    "build:web": "pnpm --filter @keyscore/web build",
    "build:api": "pnpm --filter @keyscore/api build",
    "build:shared": "pnpm --filter @keyscore/shared build",
    "build:extension": "pnpm --filter @keyscore/extension build",
    "start": "pnpm --filter @keyscore/api start",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "db:up": "docker-compose up -d mongodb redis qdrant",
    "db:down": "docker-compose down",
    "db:logs": "docker-compose logs -f",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/node": "^20.14.10",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "typescript": "^5.5.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
